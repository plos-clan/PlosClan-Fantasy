---
import VideoBack from "./VideoBack.astro";
---

<article class="pl-project relative h-full min-h-svh bg-[#080808] bg-cover bg-center text-white">
    <VideoBack/>
    <div class="pl-content px-[clamp(1.5rem,5vw,5rem)] pt-[clamp(3rem,12svh,9rem)] pb-24 [@media(max-height:600px)]:pt-8">
        <p class="m-0 mb-8 text-[0.7rem] tracking-[0.25em]">PLOS-CLAN / PROGRAMMING LANGUAGES</p>
        <h2 class="m-0 text-[clamp(3rem,8vw,9rem)] leading-[0.95] font-medium tracking-[-0.055em] [@media(max-height:600px)]:text-[clamp(2.5rem,12svh,4.5rem)]">EXPLORE<br />THE CORE</h2>
        <p class="mt-8 max-w-sm text-[clamp(0.875rem,1.1vw,1rem)] leading-[1.9]" lang="zh-CN">从语法到运行时，探索编程语言的设计与实现，让每一个想法成为可以运行的代码。</p>
    </div>
</article>

<script>
    import { gsap } from 'gsap';
    import { registerProjectAnimation } from './projectTransition';

    registerProjectAnimation('.pl-project', (root) => {
        const content = root.querySelectorAll('.pl-content > *');
        return gsap.timeline({ paused: true })
            .fromTo(content,
                { autoAlpha: 0, x: 140, scale: 0.92, transformOrigin: 'left center' },
                { autoAlpha: 1, x: 0, scale: 1, duration: 0.7, stagger: 0.15, ease: 'power2.inOut' }, 0)
            .to(content,
                { autoAlpha: 0, x: -120, scale: 1.06, duration: 0.8, stagger: 0.1, ease: 'power2.inOut' }, 1);
    });
</script>
