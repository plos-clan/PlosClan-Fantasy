---
import WaveGrid from './WaveGrid.astro';
---

<article class="os-project relative isolate h-full min-h-svh overflow-hidden bg-[#777]">
    <WaveGrid />
    <div class="os-content pointer-events-none relative z-1 px-[clamp(1.5rem,5vw,5rem)] pt-[clamp(3rem,12svh,9rem)] pb-24 text-white text-shadow-[0_2px_24px_#0008] [@media(max-height:600px)]:pt-8">
        <p class="m-0 mb-8 text-[0.7rem] tracking-[0.25em]">PLOS-CLAN / OPERATING SYSTEMS</p>
        <h2 class="m-0 text-[clamp(3rem,8vw,9rem)] leading-[0.95] font-medium tracking-[-0.055em] [@media(max-height:600px)]:text-[clamp(2.5rem,12svh,4.5rem)]">BUILD<br />FROM ZERO</h2>
        <p class="mt-8 max-w-md text-[clamp(0.875rem,1.1vw,1rem)] leading-[1.9]" lang="zh-CN">从内核到用户空间，理解计算机如何运转，<br />一起构建属于我们的操作系统。</p>
    </div>
</article>

<script>
    import { gsap } from 'gsap';
    import { registerProjectAnimation } from './projectTransition';

    registerProjectAnimation('.os-project', (root) => {
        const content = root.querySelectorAll('.os-content > *');
        return gsap.timeline({ paused: true })
            .fromTo(content,
                { autoAlpha: 0, y: 110, filter: 'blur(10px)' },
                { autoAlpha: 1, y: 0, filter: 'blur(0px)', duration: 0.76, stagger: 0.12, ease: 'power2.inOut' }, 0)
            .to(content,
                { autoAlpha: 0, y: -100, filter: 'blur(6px)', duration: 0.8, stagger: 0.1, ease: 'power2.inOut' }, 1);
    });
</script>
