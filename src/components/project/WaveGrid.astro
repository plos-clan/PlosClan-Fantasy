<div class="wave-grid" data-wave-grid aria-hidden="true">
    <canvas></canvas>
</div>

<script>
    const instances = new Map<HTMLElement, () => void>();
    let generation = 0;
    let observer: IntersectionObserver | undefined;
    function dispose() {
        generation++;
        observer?.disconnect();
        instances.forEach((cleanup) => cleanup());
        instances.clear();
    }
    function init() {
        dispose();
        const currentGeneration = generation;
        observer = new IntersectionObserver((entries) => {
            for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                const host = entry.target as HTMLElement;
                observer?.unobserve(host);
                import('./wave-grid/createWaveGrid.js').then(({ createWaveGrid }) => {
                    if (generation !== currentGeneration || !host.isConnected) return;
                    instances.set(host, createWaveGrid(host));
                }).catch((error) => {
                    if (generation !== currentGeneration || !host.isConnected) return;
                    host.dataset.fallback = 'true';
                    console.error('[WaveGrid] Failed to initialize the 3D background:', error);
                });
            }
        }, { rootMargin: '200px' });
        document.querySelectorAll<HTMLElement>('[data-wave-grid]').forEach((host) => observer!.observe(host));
    }
    init();
    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-swap', dispose);
</script>

<style>
    .wave-grid {
        position: absolute;
        inset: 0;
        overflow: hidden;
        background-color: #727680;
        background-image: linear-gradient(#aab0bd55 1px, transparent 1px), linear-gradient(90deg, #aab0bd55 1px, transparent 1px);
        background-size: 36px 36px;
    }
    .wave-grid::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, #03081788, transparent 85%); }
    canvas { display: block; width: 100%; height: 100%; }
    [data-fallback='true'] canvas { visibility: hidden; }
</style>
